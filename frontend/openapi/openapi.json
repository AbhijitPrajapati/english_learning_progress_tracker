{
  "components": {
    "schemas": {
      "Body_uploadSpeech": {
        "properties": {
          "file": {
            "contentMediaType": "application/octet-stream",
            "title": "File",
            "type": "string"
          }
        },
        "required": [
          "file"
        ],
        "title": "Body_uploadSpeech",
        "type": "object"
      },
      "CategoryFrequency": {
        "properties": {
          "category": {
            "$ref": "#/components/schemas/MistakeCategory"
          },
          "occurrences": {
            "minimum": 0.0,
            "title": "Occurrences",
            "type": "integer"
          },
          "opportunities": {
            "minimum": 0.0,
            "title": "Opportunities",
            "type": "integer"
          }
        },
        "required": [
          "category",
          "occurrences",
          "opportunities"
        ],
        "title": "CategoryFrequency",
        "type": "object"
      },
      "ChangePasswordRequest": {
        "properties": {
          "current_password": {
            "maxLength": 128,
            "minLength": 8,
            "title": "Current Password",
            "type": "string"
          },
          "new_password": {
            "maxLength": 128,
            "minLength": 8,
            "title": "New Password",
            "type": "string"
          }
        },
        "required": [
          "current_password",
          "new_password"
        ],
        "title": "ChangePasswordRequest",
        "type": "object"
      },
      "DateRange": {
        "properties": {
          "end": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "End"
          },
          "start": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Start"
          }
        },
        "title": "DateRange",
        "type": "object"
      },
      "DetectedMistake": {
        "properties": {
          "category": {
            "$ref": "#/components/schemas/MistakeCategory"
          },
          "correction": {
            "title": "Correction",
            "type": "string"
          },
          "explanation": {
            "title": "Explanation",
            "type": "string"
          },
          "original_text": {
            "title": "Original Text",
            "type": "string"
          }
        },
        "required": [
          "category",
          "original_text",
          "correction",
          "explanation"
        ],
        "title": "DetectedMistake",
        "type": "object"
      },
